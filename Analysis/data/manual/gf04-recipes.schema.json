{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dor.gf04.batch-recipes.v1",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "policy",
    "summary",
    "recipes"
  ],
  "properties": {
    "schema": {
      "const": "dor.gf04.batch-recipes.v1"
    },
    "authority": {
      "type": "object",
      "required": [
        "paths",
        "sourceHashes",
        "family",
        "publication",
        "runtimeHashRole"
      ],
      "properties": {
        "family": {
          "const": "GF-04-ORIGINAL-EVENT-COMPONENT-UNION"
        },
        "publication": {
          "const": "final-approved"
        },
        "sourceHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 63,
      "maxItems": 63,
      "items": {
        "type": "object",
        "required": [
          "pairId",
          "testIndex",
          "formalDisplayNumber",
          "finalFamilyId",
          "sourceRowHash",
          "alreadyAdmitted",
          "classKey",
          "classNameZh",
          "slot",
          "weaponFolder",
          "weaponNameZh",
          "weaponObjectPath",
          "weaponIdObjectPath",
          "overclockAId",
          "overclockBId",
          "overclockAObjectPath",
          "overclockBObjectPath",
          "pairUpgradeObjectPath",
          "pairRootGuid",
          "schematicObjectPath",
          "schematicGuid",
          "schematicItemName",
          "nativeShellObjectPath",
          "alternateItemIdObjectPath",
          "contractAlternateItemIdObjectPath",
          "alternateWeaponObjectPath",
          "orderedLeafOccurrences",
          "orderedLeafObjectPaths",
          "operations",
          "finalLeafObjectPaths",
          "actualGeneratedFinalLeafObjectPaths",
          "componentOwners",
          "runtimeRouteTemplate",
          "preparedGF01",
          "preparedGF02",
          "parameterized"
        ],
        "properties": {
          "pairId": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "testIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 452
          },
          "slot": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "classNameZh": {
            "enum": [
              "侦察兵",
              "工程师",
              "枪手",
              "钻机手"
            ]
          },
          "preparedGF01": {
            "const": false
          },
          "preparedGF02": {
            "const": false
          },
          "parameterized": {
            "const": true
          },
          "pairRootGuid": {
            "type": "string",
            "pattern": "^[A-F0-9]{8}(-[A-F0-9]{8}){3}$"
          },
          "schematicGuid": {
            "type": "string",
            "pattern": "^[A-F0-9]{8}(-[A-F0-9]{8}){3}$"
          },
          "orderedLeafObjectPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^/Game/"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operation",
                "identity",
                "sourceOccurrences",
                "sourceClassPath",
                "assetCreation",
                "selection",
                "executionGate"
              ],
              "properties": {
                "operation": {
                  "enum": [
                    "emit-native-numeric-leaf",
                    "preserve-native-affine-order",
                    "emit-native-flat-adjustment"
                  ]
                },
                "valueField": {
                  "const": "Amount"
                },
                "percentageField": {
                  "const": "IsPercentage"
                },
                "assetCreation": {
                  "enum": [
                    "new-native-standard",
                    "none"
                  ]
                },
                "sourceOccurrences": {
                  "type": "array",
                  "minItems": 2
                },
                "executionGate": {
                  "type": "object",
                  "required": [
                    "status",
                    "productionEmissionAllowed"
                  ],
                  "properties": {
                    "productionEmissionAllowed": {
                      "const": true
                    },
                    "status": {
                      "const": "ready-after-normal-native-input-check"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "emit-native-numeric-leaf"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "mergedObjectPath",
                      "valueField",
                      "percentageField",
                      "isPercentage",
                      "serializedResult"
                    ],
                    "properties": {
                      "assetCreation": {
                        "const": "new-native-standard"
                      },
                      "mergedObjectPath": {
                        "type": "string",
                        "pattern": "^/Game/DualOverclockReward/MergedLeaves/"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "preserve-native-affine-order"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "consumedSourceIndices",
                      "retainedSourceIndices",
                      "outputLeafObjectPaths"
                    ],
                    "properties": {
                      "assetCreation": {
                        "const": "none"
                      },
                      "consumedSourceIndices": {
                        "const": []
                      },
                      "retainedSourceIndices": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "emit-native-flat-adjustment"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "adjustedObjectPath",
                      "valueField",
                      "percentageField",
                      "isPercentage",
                      "serializedResult",
                      "consumedSourceIndices",
                      "retainedSourceIndices"
                    ],
                    "properties": {
                      "assetCreation": {
                        "const": "new-native-standard"
                      },
                      "isPercentage": {
                        "const": false
                      },
                      "serializedResult": {
                        "const": 0.6153846383094788
                      },
                      "consumedSourceIndices": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "retainedSourceIndices": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "adjustedObjectPath": {
                        "type": "string",
                        "pattern": "^/Game/DualOverclockReward/AdjustedLeaves/"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
