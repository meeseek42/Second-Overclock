{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dual-overclock-reward.pair-assessments.v2",
  "type": "object",
  "required": ["schema", "metadata", "assessments"],
  "properties": {
    "schema": { "const": "dual-overclock-reward.pair-assessments.v2" },
    "metadata": { "type": "object" },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pairId", "weaponName", "ocA", "ocB", "scores", "feasibility", "route", "ownerDecisionRequired"],
        "properties": {
          "pairId": { "type": "string" },
          "weaponName": { "type": "string" },
          "scores": {
            "type": "object",
            "required": ["implementationComplexity", "mechanicConflict", "destructivePower", "performanceRisk", "bugRisk"]
          },
          "feasibility": {
            "enum": ["可直接实现", "需要保护", "需要桥接", "需要定制融合", "等待决定", "暂不支持"]
          },
          "route": { "enum": ["直接叠加", "顺序保护", "轻量桥接", "定制融合"] },
          "ownerDecisionRequired": { "type": "boolean" }
        }
      }
    }
  }
}
