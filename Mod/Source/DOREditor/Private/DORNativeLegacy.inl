// A single compatibility source guard, not a replacement legacy constructor
// or proof FSM. Installation waits for the common producer/driver boundary.
bool BuildDORNativeLegacy(UBlueprint* Master,UBlueprint* Request,UBlueprint* Safety)
{
    auto* SC=LoadObject<UClass>(nullptr,TEXT("/Script/FSD.SaveGameStateComponent"));auto* JournalClass=FindFProperty<FObjectProperty>(Safety->GeneratedClass,TEXT("DOR_Journal"))->PropertyClass;if(!SC||!JournalClass)return false;
    AddTypedVariable(Master,TEXT("NativeLegacyExecuting"),MakeBoolPinType());AddTypedVariable(Master,TEXT("NativeLegacySourceOpen"),MakeBoolPinType());AddTypedVariable(Master,TEXT("NativeLegacySourceRequest"),MakeStructPinType(TBaseStructure<FGuid>::Get()));
    AddTypedVariable(Master,TEXT("NativeLegacyOwnedRequest"),MakeObjectPinType(Request->GeneratedClass));
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Master);FKismetEditorUtilities::CompileBlueprint(Master);
    auto Bound=[&](FDORNativeGraph& F,bool RequireContext=true){auto* R=F.Cache(TEXT("Request"),F.Get(TEXT("NativeActiveRequest")));F.Require(F.Get(TEXT("NativeLegacyExecuting")));F.Require(F.Get(TEXT("NativeExecutionHeld")));F.Require(F.IsValid(R));F.Require(F.Same(R,F.Get(TEXT("NativeLegacyOwnedRequest"))));if(RequireContext){F.Require(F.Not(F.Field(R,Request->GeneratedClass,TEXT("TerminalLatched"))));F.Require(F.Field(R,Request->GeneratedClass,TEXT("OriginalCaptured")));auto* Current=F.Self(TEXT("DOR_NativeRequestCurrent"));Connect(R,FindPin(Current,TEXT("RequestObject")));F.Require(Current->GetReturnValuePin());}auto* Service=F.Cache(TEXT("Safety"),F.Field(R,Request->GeneratedClass,TEXT("LocalSafety")));F.Require(F.IsValid(Service));auto* Token=F.Cache(TEXT("Token"),F.Field(R,Request->GeneratedClass,TEXT("LocalJournalId")));auto* J=F.Field(Service,Safety->GeneratedClass,TEXT("DOR_Journal"));F.Require(F.IsValid(J));F.Require(F.Eq(Token,F.Field(J,JournalClass,TEXT("TransactionId")),TEXT("EqualEqual_StrStr")));return TArray<UEdGraphPin*>{R,Service,Token};};
    {
        FDORNativeGraph F(Master,TEXT("DOR_NativeLegacySourceBegin"),Master->GeneratedClass);auto* Native=F.Input(TEXT("NativeState"),MakeObjectPinType(SC));auto* Character=F.Input(TEXT("Character"),MakeObjectPinType(UPlayerCharacterID::StaticClass()));const auto L=Bound(F);auto* R=L[0];auto* S=L[1];auto* Token=L[2];F.Require(F.Not(F.Get(TEXT("NativeLegacySourceOpen"))));F.Require(F.IsValid(Native));F.Require(F.Same(Character,F.Field(R,Request->GeneratedClass,TEXT("Character"))));auto* Owner=F.Call(UActorComponent::StaticClass(),TEXT("GetOwner"));Connect(Native,FindPin(Owner,UEdGraphSchema_K2::PN_Self));F.Require(F.Same(Owner->GetReturnValuePin(),F.Field(R,Request->GeneratedClass,TEXT("TargetState"))));
        auto* Bank=F.Self(TEXT("DOR_NativeBankReady"));Connect(F.Field(R,Request->GeneratedClass,TEXT("Request")),FindPin(Bank,TEXT("RequestId")));F.Require(Bank->GetReturnValuePin());auto* Deadline=F.Cache(TEXT("Deadline"),F.Field(R,Request->GeneratedClass,TEXT("QueuedDeadline")));auto* Items=F.Cache(TEXT("Items"),F.Field(R,Request->GeneratedClass,TEXT("AcceptedLoadout")));auto* Selections=F.Cache(TEXT("Selections"),F.Field(R,Request->GeneratedClass,TEXT("AcceptedSelections")));auto* Recovery=F.Branch(F.Get(TEXT("NativeScopeRecovery")));F.Set(F.Variable(Deadline),F.Field(R,Request->GeneratedClass,TEXT("RecoveryDeadline")));F.Set(F.Variable(Items),F.Field(R,Request->GeneratedClass,TEXT("OriginalLoadout")));F.Set(F.Variable(Selections),F.Field(R,Request->GeneratedClass,TEXT("OriginalSelections")));F.Merge(Recovery->GetElsePin());auto* Before=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Less_FloatFloat"));Connect(F.RealNow(),FindPin(Before,TEXT("A")));Connect(Deadline,FindPin(Before,TEXT("B")));F.Require(Before->GetReturnValuePin());
        auto* Preserved=F.Self(TEXT("DOR_NativePersistentProof"));Connect(R,FindPin(Preserved,TEXT("RequestObject")));FindPin(Preserved,TEXT("PreservationOnly"))->DefaultValue=TEXT("true");FindPin(Preserved,TEXT("AllowTargetTransition"))->DefaultValue=TEXT("true");auto* Lane=F.Self(TEXT("DOR_NativeOwnerFirstLane"));Connect(R,FindPin(Lane,TEXT("RequestObject")));auto* Probe=F.Cache(TEXT("FirstOwnerConsumerProbe"),F.And(Lane->GetReturnValuePin(),F.And(F.Eq(F.Field(R,Request->GeneratedClass,TEXT("Phase")),F.Int(2)),F.And(F.Field(R,Request->GeneratedClass,TEXT("LegacyPrepStarted")),F.Not(F.Field(R,Request->GeneratedClass,TEXT("LegacyFirstSourceProbeSeen")))))));auto* FirstProbe=F.Branch(Probe);F.Put(R,Request->GeneratedClass,TEXT("LegacyFirstSourceProbeSeen"),nullptr,TEXT("true"));F.Merge(FirstProbe->GetElsePin());Connect(Probe,FindPin(Preserved,TEXT("ProbeReadOnly")));FindPin(Preserved,TEXT("ProbeStage"))->DefaultValue=TEXT("first-owner-preparation-source-preservation");F.Require(Preserved->GetReturnValuePin());auto* Exact=F.Call(Safety->GeneratedClass,TEXT("DOR_SourceInputsMatch"));Connect(S,FindPin(Exact,UEdGraphSchema_K2::PN_Self));Connect(F.Field(S,Safety->GeneratedClass,TEXT("DOR_Journal")),FindPin(Exact,TEXT("Record")));Connect(Items,FindPin(Exact,TEXT("Loadout")));Connect(Selections,FindPin(Exact,TEXT("Selections")));F.Require(Exact->GetReturnValuePin());
        // Latch before calling the stage operation: partial staging/IO failure
        // is still a reachable window requiring checked selective restore.
        F.Set(TEXT("NativeLegacySourceRequest"),F.Field(R,Request->GeneratedClass,TEXT("Request")));F.Set(TEXT("NativeLegacySourceOpen"),nullptr,TEXT("true"));F.Set(TEXT("NativeSourceWindowStartedAt"),F.RealNow());auto* Stage=F.Call(Safety->GeneratedClass,TEXT("DOR_SourceStage"));Connect(S,FindPin(Stage,UEdGraphSchema_K2::PN_Self));Connect(Token,FindPin(Stage,TEXT("TransactionId")));F.Return(Stage->GetReturnValuePin());F.Compile();
    }
    {
        FDORNativeGraph F(Master,TEXT("DOR_NativeLegacySourceEnd"),Master->GeneratedClass);const auto L=Bound(F,false);auto* R=L[0];auto* S=L[1];auto* Token=L[2];F.Require(F.Get(TEXT("NativeLegacySourceOpen")));F.Require(F.Eq(F.Get(TEXT("NativeLegacySourceRequest")),F.Field(R,Request->GeneratedClass,TEXT("Request")),TEXT("EqualEqual_GuidGuid")));
        // No validation return precedes restoration once the source lease is
        // open. In particular a changed mission input must not strand keys.
        auto* Restore=F.Call(Safety->GeneratedClass,TEXT("DOR_SourceRestore"));Connect(S,FindPin(Restore,UEdGraphSchema_K2::PN_Self));Connect(F.Field(S,Safety->GeneratedClass,TEXT("DOR_Journal")),FindPin(Restore,TEXT("Record")));F.Require(Restore->GetReturnValuePin(),TEXT("[DOR-NATIVE]|stage=legacy-source-restore-failed|barrier=held|journal=retained"));F.Require(F.Eq(Token,F.Field(S,Safety->GeneratedClass,TEXT("DOR_CheckedEquipmentRestoreTransactionId")),TEXT("EqualEqual_StrStr")));F.Set(TEXT("NativeLegacySourceOpen"),nullptr,TEXT("false"));F.Set(TEXT("NativeSourceWindowRestoredAt"),F.RealNow());auto* WindowRecord=F.Self(TEXT("DOR_NativeRecordSourceWindow"));Connect(R,FindPin(WindowRecord,TEXT("RequestObject")));
        auto* Proof=F.Self(TEXT("DOR_NativePersistentProof"));Connect(R,FindPin(Proof,TEXT("RequestObject")));FindPin(Proof,TEXT("PreservationOnly"))->DefaultValue=TEXT("true");FindPin(Proof,TEXT("AllowTargetTransition"))->DefaultValue=TEXT("true");F.Return(Proof->GetReturnValuePin());F.Compile();
    }
    return Master->Status!=BS_Error;
}
