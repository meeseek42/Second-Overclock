        D.Add(TEXT("currentActor"),D.Path(A),NAME_None);D.Add(TEXT("priorActor"),D.Path(Prior),NAME_None);D.Add(TEXT("expectedActor"),D.Path(F.Field(R,Request->GeneratedClass,TEXT("ExpectedActor"))),NAME_None);D.Add(TEXT("currentPriorSame"),F.Same(A,Prior));
        auto* AC=F.Call(UGameplayStatics::StaticClass(),TEXT("GetObjectClass"));Connect(A,FindPin(AC,TEXT("Object")));D.Add(TEXT("currentClass"),D.ClassPath(AC->GetReturnValuePin()),NAME_None);D.Add(TEXT("priorClass"),D.ClassPath(F.Field(R,Request->GeneratedClass,TEXT("OriginalItemClass"))),NAME_None);
    };
    auto Tuple=[&](FDORNativeReceiptGraph& F,UEdGraphPin* R,FDORNativeProbeLine& D){for(const auto& T:DORNativeTuplePins())D.Add(T.Key.ToString(),F.Field(R,Request->GeneratedClass,T.Key),T.Key==TEXT("Key")?FName(NAME_None):T.Key==TEXT("Epoch")||T.Key==TEXT("Request")?FName(TEXT("Conv_GuidToString")):FName(TEXT("Conv_IntToString")));for(const TCHAR* N:{TEXT("Phase"),TEXT("Status")})D.Add(N,F.Field(R,Request->GeneratedClass,N),TEXT("Conv_IntToString"));};
    {
        FDORNativeReceiptGraph F(Master,TEXT("DOR_NativeClearFirstFailure"),Master->GeneratedClass);auto* R=F.Input(TEXT("RequestObject"),MakeObjectPinType(Request->GeneratedClass));auto* Site=F.Input(TEXT("Site"),MakeStringPinType());auto* Count=F.Input(TEXT("RootCount"),MakeIntPinType());auto* Matches=F.Input(TEXT("RootMatches"),MakeBoolPinType());auto* OC=F.Input(TEXT("ExpectedOC"),MakeStructPinType(TBaseStructure<FGuid>::Get()));auto* RootsObserved=F.Input(TEXT("RootsObserved"),MakeBoolPinType());
        F.QuietRequire(F.IsValid(R));F.QuietRequire(F.Eq(F.Field(R,Request->GeneratedClass,TEXT("Operation")),F.Int(1)));F.QuietRequire(F.Not(F.Get(TEXT("NativeScopeRecovery"))));F.QuietRequire(F.Eq(F.Field(R,Request->GeneratedClass,TEXT("FirstClearFailureSite")),F.Str(TEXT("")),TEXT("EqualEqual_StrStr")));F.Put(R,Request->GeneratedClass,TEXT("FirstClearFailureSite"),Site);
        FDORNativeProbeLine D(F,TEXT("ClearFirstFailure"),TEXT("[DOR-CLEAR-FAILURE]|outcome=false|first=true|gameplay=unknown"));Tuple(F,R,D);D.Add(TEXT("site"),Site,NAME_None);D.Add(TEXT("rootsObserved"),RootsObserved);D.Add(TEXT("observedRootCount"),Count,TEXT("Conv_IntToString"));D.Add(TEXT("rootsMatchExpected"),Matches);D.Add(TEXT("evaluatedExpectedOC"),OC,TEXT("Conv_GuidToString"));D.Add(TEXT("externalOC"),F.FieldOf(F.Field(R,Request->GeneratedClass,TEXT("ClearSourceSelection")),FItemUpgradeSelection::StaticStruct(),TEXT("EquippedOverclock")),TEXT("Conv_GuidToString"));Actors(F,R,D);
        for(const TCHAR* N:{TEXT("ClearSourceChecked"),TEXT("NativeSubmitted"),TEXT("CancelRequested"),TEXT("TerminalLatched")})D.Add(N,F.Field(R,Request->GeneratedClass,N));for(const TCHAR* N:{TEXT("NativeExecutionHeld"),TEXT("NativeLegacyExecuting"),TEXT("NativeLegacySourceOpen")})D.Add(N,F.Get(N));
        auto* SC=LoadObject<UClass>(nullptr,TEXT("/Script/FSD.SaveGameStateComponent"));auto* Native=F.Cache(TEXT("NativeInputs"),F.Component(F.Field(R,Request->GeneratedClass,TEXT("TargetState")),SC));auto* Have=F.Branch(F.IsValid(Native));auto* Diff=F.Self(TEXT("DOR_NativeInputDifference"));Connect(F.Field(R,Request->GeneratedClass,TEXT("AcceptedLoadout")),FindPin(Diff,TEXT("ExpectedLoadout")));Connect(F.Field(R,Request->GeneratedClass,TEXT("AcceptedSelections")),FindPin(Diff,TEXT("ExpectedSelections")));Connect(F.Field(Native,SC,TEXT("EquippedLoadout")),FindPin(Diff,TEXT("ActualLoadout")));Connect(F.Field(Native,SC,TEXT("ItemUpgradeSelections")),FindPin(Diff,TEXT("ActualSelections")));D.Add(TEXT("acceptedCurrentInputDifference"),Diff->GetReturnValuePin(),NAME_None);F.Merge(Have->GetElsePin());
        D.Record();F.Done();F.Compile();if(Master->Status==BS_Error)return false;
    }
    {
        FDORNativeReceiptGraph F(Master,TEXT("DOR_NativeFirstCancellation"),Master->GeneratedClass);auto* R=F.Input(TEXT("RequestObject"),MakeObjectPinType(Request->GeneratedClass));auto* Site=F.Input(TEXT("Site"),MakeStringPinType());auto* CurrentKnown=F.Input(TEXT("CurrentKnown"),MakeBoolPinType());auto* Current=F.Input(TEXT("CurrentOutcome"),MakeBoolPinType());auto* DeadlineKnown=F.Input(TEXT("DeadlineKnown"),MakeBoolPinType());auto* InTime=F.Input(TEXT("InTimeOutcome"),MakeBoolPinType());
        F.QuietRequire(F.IsValid(R));F.QuietRequire(F.Eq(F.Field(R,Request->GeneratedClass,TEXT("Operation")),F.Int(0)));auto* Constructed=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Greater_FloatFloat"));Connect(F.Field(R,Request->GeneratedClass,TEXT("AuthorityConstructedAt")),FindPin(Constructed,TEXT("A")));F.QuietRequire(Constructed->GetReturnValuePin());F.QuietRequire(F.Not(F.Field(R,Request->GeneratedClass,TEXT("PreObservationIssued"))));F.QuietRequire(F.Eq(F.Field(R,Request->GeneratedClass,TEXT("FirstCancellationSite")),F.Str(TEXT("")),TEXT("EqualEqual_StrStr")));F.Put(R,Request->GeneratedClass,TEXT("FirstCancellationSite"),Site);
        FDORNativeProbeLine D(F,TEXT("FirstCancellation"),TEXT("[DOR-FIRST-CANCEL]|first=true|stage=constructed-before-owner-observation|gameplay=unknown"));Tuple(F,R,D);D.Add(TEXT("caller"),Site,NAME_None);D.Add(TEXT("preexistingCancel"),F.Field(R,Request->GeneratedClass,TEXT("CancelRequested")));D.Add(TEXT("currentKnown"),CurrentKnown);D.Add(TEXT("currentOutcome"),Current);D.Add(TEXT("lifecycleClosed"),F.Get(TEXT("NativeLifecycleClosed")));D.Add(TEXT("deadlineKnown"),DeadlineKnown);D.Add(TEXT("inTimeOutcome"),InTime);D.Add(TEXT("deadline"),F.Field(R,Request->GeneratedClass,TEXT("QueuedDeadline")),TEXT("Conv_FloatToString"));D.Add(TEXT("constructedAt"),F.Field(R,Request->GeneratedClass,TEXT("AuthorityConstructedAt")),TEXT("Conv_FloatToString"));
        auto* CC=FindFProperty<FObjectProperty>(Request->GeneratedClass,TEXT("NativeContext"))->PropertyClass;auto* C=F.Field(R,Request->GeneratedClass,TEXT("NativeContext"));auto* Have=F.Branch(F.And(F.IsValid(C),F.Same(R,F.Field(C,CC,TEXT("NativeActiveRequest")))));D.Add(TEXT("ownerPhase"),F.Field(C,CC,TEXT("NativeOwnerPhase")),TEXT("Conv_IntToString"));D.Add(TEXT("observePhase"),F.Field(C,CC,TEXT("NativeObservePhase")),TEXT("Conv_IntToString"));D.Add(TEXT("serverPhase"),F.Field(C,CC,TEXT("NativeServerPhase")),TEXT("Conv_IntToString"));D.Add(TEXT("ownerDeadline"),F.Field(C,CC,TEXT("NativeOwnerDeadline")),TEXT("Conv_FloatToString"));D.Add(TEXT("recoveryDeadline"),F.Field(R,Request->GeneratedClass,TEXT("RecoveryDeadline")),TEXT("Conv_FloatToString"));D.Add(TEXT("lifecycleReady"),F.Field(C,CC,TEXT("NativeLifecycleReady")));auto* Effective=F.Cache(TEXT("EffectiveOwnerDeadline"),F.Field(C,CC,TEXT("NativeOwnerDeadline")));auto* Clock=F.Cache(TEXT("ClockSource"),F.Str(TEXT("accepted-owner")));auto* Initialized=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Greater_FloatFloat"));Connect(F.Field(R,Request->GeneratedClass,TEXT("RecoveryDeadline")),FindPin(Initialized,TEXT("A")));auto* Range=F.Call(UKismetMathLibrary::StaticClass(),TEXT("InRange_IntInt"));Connect(F.Field(R,Request->GeneratedClass,TEXT("Phase")),FindPin(Range,TEXT("Value")));FindPin(Range,TEXT("Min"))->DefaultValue=TEXT("91");FindPin(Range,TEXT("Max"))->DefaultValue=TEXT("97");FindPin(Range,TEXT("InclusiveMin"))->DefaultValue=TEXT("true");FindPin(Range,TEXT("InclusiveMax"))->DefaultValue=TEXT("true");auto* Recovery=F.Branch(F.And(Initialized->GetReturnValuePin(),Range->GetReturnValuePin()));F.Set(F.Variable(Effective),F.Field(R,Request->GeneratedClass,TEXT("RecoveryDeadline")));F.Set(F.Variable(Clock),F.Str(TEXT("initialized-current-request-recovery")));F.Merge(Recovery->GetElsePin());D.Add(TEXT("effectiveOwnerDeadline"),Effective,TEXT("Conv_FloatToString"));D.Add(TEXT("clockSource"),Clock,NAME_None);auto* Cause=F.Call(UKismetMathLibrary::StaticClass(),TEXT("SelectString"));FindPin(Cause,TEXT("A"))->DefaultValue=TEXT("owner-lifecycle-close");FindPin(Cause,TEXT("B"))->DefaultValue=TEXT("owner-poll-or-authority-site-see-caller");Connect(F.Not(F.Field(C,CC,TEXT("NativeLifecycleReady"))),FindPin(Cause,TEXT("bPickA")));D.Add(TEXT("ownerCause"),Cause->GetReturnValuePin(),NAME_None);D.Add(TEXT("now"),F.RealNow(),TEXT("Conv_FloatToString"));F.Merge(Have->GetElsePin());D.Add(TEXT("priorReason"),F.Field(R,Request->GeneratedClass,TEXT("Reason")),NAME_None);Actors(F,R,D);D.Record();F.Done();F.Compile();if(Master->Status==BS_Error)return false;
    }
    return true;
