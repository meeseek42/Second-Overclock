bool InstallDOR156CancellationProbes(UBlueprint* Master,UBlueprint* Request,UBlueprint* Context)
{
    int32 Hooks=0;
    // Only existing true cancellation setters are instrumented; no polling or
    // success tracing. The helper rejects later/repeated/nonconstructed cases.
    for(auto* BP:{Master,Context})
    {
    TArray<UEdGraph*> All;BP->GetAllGraphs(All);for(auto* G:All)
    {
        int32 Site=0;
        for(auto* N:TArray<UEdGraphNode*>(G->Nodes))if(auto* Set=Cast<UK2Node_VariableSet>(N))if(Set->VariableReference.GetMemberName()==TEXT("CancelRequested"))
        {
            auto* Value=FindPin(Set,TEXT("CancelRequested"));if(!Value||Value->LinkedTo.Num()||Value->DefaultValue!=TEXT("true"))continue;
            auto* Target=FindPin(Set,UEdGraphSchema_K2::PN_Self);if(!Target||Target->LinkedTo.Num()!=1)return false;
            auto* Hook=AddCall(G,Master->GeneratedClass,TEXT("DOR_NativeFirstCancellation"),0,0);Connect(Target->LinkedTo[0],FindPin(Hook,TEXT("RequestObject")));++Site;FString Category=TEXT("caller-rejected");if(G->GetFName()==TEXT("DOR_NativePumpRequest"))Category=Site==1?TEXT("lifecycle-or-stale"):Site==2?TEXT("equipment-deadline"):TEXT("preexisting-cancel-or-phase91");else if(G->GetName().Contains(TEXT("Deadline")))Category=TEXT("owner-deadline");else if(G->GetName().Contains(TEXT("Lifecycle")))Category=TEXT("lifecycle");FindPin(Hook,TEXT("Site"))->DefaultValue=G->GetName()+FString::Printf(TEXT(":cancel-set-%d:"),Site)+Category;
            Connect(BP==Master?SelfPin(G,0,0):AddVariableGet(G,TEXT("NativeMaster"),0,0)->GetValuePin(),FindPin(Hook,UEdGraphSchema_K2::PN_Self));
            if(BP==Master&&G->GetFName()==TEXT("DOR_NativePumpRequest"))
            {
                auto Cached=[&](const TCHAR* Label)->UEdGraphPin*{for(const auto& V:Master->NewVariables)if(V.VarName.ToString().StartsWith(FString(TEXT("DOR_NativePumpRequest_"))+Label+TEXT("_")))return AddVariableGet(G,V.VarName,0,0)->GetValuePin();return nullptr;};
                auto* Current=Cached(TEXT("CancelCurrentOutcome"));if(!Current)return false;FindPin(Hook,TEXT("CurrentKnown"))->DefaultValue=TEXT("true");Connect(Current,FindPin(Hook,TEXT("CurrentOutcome")));
                if(Site>1){auto* InTime=Cached(TEXT("CancelInTimeOutcome"));if(!InTime)return false;FindPin(Hook,TEXT("DeadlineKnown"))->DefaultValue=TEXT("true");Connect(InTime,FindPin(Hook,TEXT("InTimeOutcome")));}
            }
            const auto Before=Set->GetExecPin()->LinkedTo;Set->GetExecPin()->BreakAllPinLinks();for(auto* P:Before)Connect(P,Hook->GetExecPin());Connect(Hook->GetThenPin(),Set->GetExecPin());++Hooks;
        }
    }
    }
    UE_LOG(LogTemp,Display,TEXT("DOR156 failure-only cancellation setters instrumented=%d"),Hooks);
    for(auto* BP:{Master,Context}){FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(BP);FKismetEditorUtilities::CompileBlueprint(BP);if(BP->Status==BS_Error)return false;}return Hooks>0;
}
