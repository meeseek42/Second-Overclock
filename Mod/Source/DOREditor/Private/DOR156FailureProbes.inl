bool BuildDOR156FailureProbes(UBlueprint* Master,UBlueprint* Request)
{
    for(const TCHAR* N:{TEXT("FirstClearFailureSite"),TEXT("FirstCancellationSite")})AddTypedVariable(Request,N,MakeStringPinType());
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Request);FKismetEditorUtilities::CompileBlueprint(Request);
