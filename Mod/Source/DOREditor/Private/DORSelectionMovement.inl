    auto Insert=[&](UEdGraphPin* Out,const TCHAR* Name,UEdGraphPin* Actor=nullptr){auto* G=Out->GetOwningNode()->GetGraph();auto Next=Out->LinkedTo;Out->BreakAllPinLinks();auto* C=AddSelfCall(G,Name,0,0);if(Actor)Connect(Actor,FindPin(C,TEXT("Actor")));Connect(Out,C->GetExecPin());for(auto* N:Next)Connect(C->GetThenPin(),N);};
