    auto* Movement=LoadObject<UClass>(nullptr,TEXT("/Script/FSD.DeepPathfinderMovement"));auto* Component=LoadObject<UClass>(nullptr,TEXT("/Script/Engine.ActorComponent"));auto* Pawn=LoadObject<UClass>(nullptr,TEXT("/Script/FSD.FSDPawn"));if(!Movement||!Component||!Pawn)return false;
