    auto Note=[&](FDORNativeGraph& F,const FString& B,UEdGraphPin* M,const TCHAR* Stage){auto* Selected=F.Branch(Has(F,F.Get(*(B+TEXT("Examples"))),M));FDORNativeProbeLine D(F,TEXT("MovementLease"),TEXT("[DOR-SELECTION-MOVEMENT]|ownership=component-true-to-false-only|gameplay=unproved"));auto* Owner=Read(F,Component,TEXT("GetOwner"),M);D.Add(TEXT("stage"),F.Str(Stage),NAME_None);D.Add(TEXT("authority"),DORLocalHost(F));D.Add(TEXT("epoch"),F.Get(TEXT("NativeEpoch")),TEXT("Conv_GuidToString"));D.Add(TEXT("round"),F.Get(TEXT("SelectionMovementRound")),TEXT("Conv_IntToString"));D.Add(TEXT("localRound"),F.Get(TEXT("SelectionMovementLocalRound")),TEXT("Conv_IntToString"));D.Add(TEXT("generation"),F.Get(TEXT("SelectionMovementLocalGeneration")),TEXT("Conv_IntToString"));D.Add(TEXT("component"),D.Path(M),NAME_None);auto* Class=F.Call(UKismetSystemLibrary::StaticClass(),TEXT("GetObjectClass"));Connect(M,FindPin(Class,TEXT("Object")));auto* ClassName=F.Call(UKismetSystemLibrary::StaticClass(),TEXT("GetClassDisplayName"));Connect(Class->GetReturnValuePin(),FindPin(ClassName,TEXT("Class")));D.Add(TEXT("class"),ClassName->GetReturnValuePin(),NAME_None);D.Add(TEXT("owner"),D.Path(Owner),NAME_None);D.Add(TEXT("originalTick"),F.Str(TEXT("true")),NAME_None);D.Add(TEXT("tick"),Read(F,Component,TEXT("IsComponentTickEnabled"),M));auto* Position=F.Call(UKismetStringLibrary::StaticClass(),TEXT("Conv_VectorToString"));Connect(Read(F,AActor::StaticClass(),TEXT("K2_GetActorLocation"),Owner),FindPin(Position,TEXT("InVec")));D.Add(TEXT("position"),Position->GetReturnValuePin(),NAME_None);D.Record();F.Merge(Selected->GetElsePin());};
    {
