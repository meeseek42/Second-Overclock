    auto* Resume=FindFunctionGraph(Master,TEXT("DOR_SelectionResumeAll"));Insert(FindFunctionEntry(Resume)->FindPin(UEdGraphSchema_K2::PN_Then),TEXT("DOR_SelectionMovementAuthorityRelease"));
    auto* World=FindFunctionGraph(Master,TEXT("DOR_SelectionWorldExit"));Insert(FindFunctionEntry(World)->FindPin(UEdGraphSchema_K2::PN_Then),TEXT("DOR_SelectionMovementLocalRelease"));
    for(bool Start:{true,false}){auto* G=FindFunctionGraph(Proxy,Start?TEXT("DOR_SelectionControlLocalAcquire"):TEXT("DOR_SelectionControlLocalRelease"));auto* E=FindFunctionEntry(G);auto* Out=E->FindPin(UEdGraphSchema_K2::PN_Then);auto Next=Out->LinkedTo;Out->BreakAllPinLinks();auto* Find=AddCall(G,UGameplayStatics::StaticClass(),TEXT("GetActorOfClass"),0,0);FindPin(Find,TEXT("ActorClass"))->DefaultObject=Master->GeneratedClass;auto* Cast=AddNode<UK2Node_DynamicCast>(G,0,0);Cast->TargetType=Master->GeneratedClass;Cast->SetPurity(true);Cast->AllocateDefaultPins();ForcePinType(Cast->GetCastSourcePin(),MakeObjectPinType(UObject::StaticClass()));Connect(Find->GetReturnValuePin(),Cast->GetCastSourcePin());auto* C=AddCall(G,Master->GeneratedClass,Start?TEXT("DOR_SelectionMovementLocalAcquire"):TEXT("DOR_SelectionMovementLocalClose"),0,0);Connect(Cast->GetCastResultPin(),FindPin(C,UEdGraphSchema_K2::PN_Self));Connect(SelfPin(G,0,0),FindPin(C,TEXT("Proxy")));for(const TCHAR* N:{TEXT("Player"),TEXT("Generation")})Connect(E->FindPin(N),FindPin(C,N));Connect(Out,Find->GetExecPin());Connect(Find->GetThenPin(),C->GetExecPin());for(auto* N:Next)Connect(C->GetThenPin(),N);}
    auto* EG=FBlueprintEditorUtils::FindEventGraph(Master);for(auto* N:TArray<UEdGraphNode*>(EG->Nodes))if(auto* E=Cast<UK2Node_Event>(N))if(E->EventReference.GetMemberName()==TEXT("ReceiveTick"))Insert(E->FindPin(UEdGraphSchema_K2::PN_Then),TEXT("DOR_SelectionMovementPoll"));
