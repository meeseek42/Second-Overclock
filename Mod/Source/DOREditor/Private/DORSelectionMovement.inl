            auto* Stop=F.Call(Component,TEXT("SetComponentTickEnabled"));Connect(M,FindPin(Stop,UEdGraphSchema_K2::PN_Self));FindPin(Stop,TEXT("bEnabled"))->DefaultValue=TEXT("false");F.QuietRequire(F.Not(Read(F,Component,TEXT("IsComponentTickEnabled"),M)));Add(F,F.Get(*(B+TEXT("Owned"))),M);auto* Example=F.Branch(Less(F,F.Array(TEXT("Array_Length"),F.Get(*(B+TEXT("Examples"))))->GetReturnValuePin(),3));Add(F,F.Get(*(B+TEXT("Examples"))),M);F.Merge(Example->GetElsePin());Note(F,B,M,TEXT("acquire"));if(Authority){Add(F,F.Get(TEXT("SelectionMovementPawns")),P);F.Self(TEXT("DOR_SelectionMovementPublish"));}F.Done();F.Compile();
        }
        {
            FDORNativeReceiptGraph F(Master,*(FString(TEXT("DOR_"))+B+TEXT("Release")),Master->GeneratedClass);auto* Each=F.Each(F.Get(*(B+TEXT("Owned"))));auto* M=FindPin(Each,TEXT("Array Element"));auto* Valid=F.Branch(F.IsValid(M));Note(F,B,M,TEXT("pre-close"));auto* Still=F.Branch(F.Not(Read(F,Component,TEXT("IsComponentTickEnabled"),M)));auto* Resume=F.Call(Component,TEXT("SetComponentTickEnabled"));Connect(M,FindPin(Resume,UEdGraphSchema_K2::PN_Self));FindPin(Resume,TEXT("bEnabled"))->DefaultValue=TEXT("true");F.Merge(Still->GetElsePin());Note(F,B,M,TEXT("release"));F.Merge(Valid->GetElsePin());F.Tail=FindPin(Each,TEXT("Completed"));F.Array(TEXT("Array_Clear"),F.Get(*(B+TEXT("Owned"))));F.Array(TEXT("Array_Clear"),F.Get(*(B+TEXT("Examples"))));if(Authority){F.Array(TEXT("Array_Clear"),F.Get(TEXT("SelectionMovementPawns")));F.Set(TEXT("SelectionMovementRound"),nullptr,TEXT("0"));F.Self(TEXT("DOR_SelectionMovementPublish"));}else{F.Set(TEXT("SelectionMovementLocalHeld"),nullptr,TEXT("false"));F.Set(TEXT("SelectionMovementLocalProxy"),nullptr);F.Set(TEXT("SelectionMovementLocalPlayer"),nullptr);F.Set(TEXT("SelectionMovementLocalRound"),nullptr,TEXT("0"));}F.Done();F.Compile();
        }
        {
            FDORNativeReceiptGraph F(Master,*(FString(TEXT("DOR_"))+B+TEXT("Sample")),Master->GeneratedClass);F.QuietRequire(F.Not(F.Get(*(B+TEXT("Sampled")))));F.QuietRequire(F.Not(F.Eq(F.Array(TEXT("Array_Length"),F.Get(*(B+TEXT("Owned"))))->GetReturnValuePin(),F.Int(0))));auto* Due=F.Call(UKismetMathLibrary::StaticClass(),TEXT("GreaterEqual_FloatFloat"));Connect(F.RealNow(),FindPin(Due,TEXT("A")));Connect(F.Get(*(B+TEXT("SampleDue"))),FindPin(Due,TEXT("B")));F.QuietRequire(Due->GetReturnValuePin());F.Set(*(B+TEXT("Sampled")),nullptr,TEXT("true"));auto* Each=F.Each(F.Get(*(B+TEXT("Examples"))));auto* M=FindPin(Each,TEXT("Array Element"));auto* Valid=F.Branch(F.IsValid(M));Note(F,B,M,TEXT("held"));F.Merge(Valid->GetElsePin());F.Tail=FindPin(Each,TEXT("Completed"));F.Done();F.Compile();
        }
    }
    for(bool Start:{true,false})
    {
        FDORNativeReceiptGraph F(Master,Start?TEXT("DOR_SelectionMovementLocalAcquire"):TEXT("DOR_SelectionMovementLocalClose"),Master->GeneratedClass);auto* P=F.Input(TEXT("Proxy"),MakeObjectPinType(Proxy->GeneratedClass));auto* Player=F.Input(TEXT("Player"),MakeObjectPinType(APlayerCharacter::StaticClass()));auto* Generation=F.Input(TEXT("Generation"),MakeIntPinType());F.QuietRequire(F.Not(DORLocalHost(F)));if(Start){F.QuietRequire(F.Not(F.Get(TEXT("SelectionMovementLocalHeld"))));F.QuietRequire(F.And(F.IsValid(P),F.IsValid(Player)));F.Set(TEXT("SelectionMovementLocalProxy"),P);F.Set(TEXT("SelectionMovementLocalPlayer"),Player);F.Set(TEXT("SelectionMovementLocalGeneration"),Generation);F.Set(TEXT("SelectionMovementLocalRound"),nullptr,TEXT("0"));F.Set(TEXT("SelectionMovementLocalHeld"),nullptr,TEXT("true"));}else{F.QuietRequire(F.Get(TEXT("SelectionMovementLocalHeld")));F.QuietRequire(F.Same(P,F.Get(TEXT("SelectionMovementLocalProxy"))));F.QuietRequire(F.Same(Player,F.Get(TEXT("SelectionMovementLocalPlayer"))));F.QuietRequire(F.Eq(Generation,F.Get(TEXT("SelectionMovementLocalGeneration"))));F.Self(TEXT("DOR_SelectionMovementLocalRelease"));}F.Done();F.Compile();
    }
