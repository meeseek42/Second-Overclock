    auto* Pause=FindFunctionGraph(Master,TEXT("DOR_SelectionPausePawn"));int32 Hooks=0;for(auto* N:TArray<UEdGraphNode*>(Pause->Nodes))if(auto* S=Cast<UK2Node_VariableSet>(N))if(S->VariableReference.GetMemberName()==TEXT("SelectionAIPauseConfirmed")){Insert(FindPin(S,UEdGraphSchema_K2::PN_Then),TEXT("DOR_SelectionMovementAuthorityTry"),FindFunctionEntry(Pause)->FindPin(TEXT("Enemy")));++Hooks;}if(Hooks!=1)return false;
