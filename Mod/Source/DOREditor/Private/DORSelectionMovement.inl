        FDORNativeReceiptGraph F(Master,TEXT("DOR_SelectionMovementPoll"),Master->GeneratedClass);F.Self(TEXT("DOR_SelectionMovementAuthoritySample"));auto* Held=F.Branch(F.Get(TEXT("SelectionMovementLocalHeld")));auto* P=F.Cache(TEXT("Proxy"),F.Get(TEXT("SelectionMovementLocalProxy")));auto* Local=F.Call(UGameplayStatics::StaticClass(),TEXT("GetPlayerCharacter"));auto* Valid=F.Branch(F.And(F.IsValid(P),F.And(F.IsValid(F.Get(TEXT("SelectionMovementLocalPlayer"))),F.Same(Local->GetReturnValuePin(),F.Get(TEXT("SelectionMovementLocalPlayer"))))));auto* Good=F.Tail;F.Tail=Valid->GetElsePin();F.Self(TEXT("DOR_SelectionMovementLocalRelease"));F.Return();F.Tail=Good;
        F.QuietRequire(F.Eq(F.Field(P,Proxy->GeneratedClass,TEXT("SelectionMovementPublishedGeneration")),F.Get(TEXT("SelectionMovementLocalGeneration"))));auto* Round=F.Cache(TEXT("Round"),F.Field(P,Proxy->GeneratedClass,TEXT("SelectionMovementPublishedRound")));F.QuietRequire(F.Not(F.Eq(Round,F.Int(0))));auto* First=F.Branch(F.Eq(F.Get(TEXT("SelectionMovementLocalRound")),F.Int(0)));F.Set(TEXT("SelectionMovementLocalRound"),Round);F.Merge(First->GetElsePin());F.QuietRequire(F.Eq(Round,F.Get(TEXT("SelectionMovementLocalRound"))));auto* Each=F.Each(F.Field(P,Proxy->GeneratedClass,TEXT("SelectionMovementPublishedPawns")));auto* Try=F.Self(TEXT("DOR_SelectionMovementLocalTry"));Connect(FindPin(Each,TEXT("Array Element")),FindPin(Try,TEXT("Actor")));F.Tail=FindPin(Each,TEXT("Completed"));F.Self(TEXT("DOR_SelectionMovementLocalSample"));F.Merge(Held->GetElsePin());F.Done();F.Compile();
