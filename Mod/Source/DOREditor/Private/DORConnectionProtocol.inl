void DORConnectionBind(FDORConnectionGraph& F,UClass* C,const TCHAR* Property,UEdGraphPin* Object,const TCHAR* Function,bool Remove=false)
{
    auto* P=FindFProperty<FMulticastDelegateProperty>(C,Property);check(P);
