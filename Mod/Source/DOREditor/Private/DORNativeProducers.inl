// Producers submit identity-bound metadata only. The scheduler captures live
// inputs after a same-player predecessor has actually settled.
bool ValidateDORManualRevisionOwnership(UBlueprint* MenuHost)
{
    // Execute only the transient state helpers; no world, Pawn or save fixture.
    auto* H=MenuHost->GeneratedClass->GetDefaultObject();FStructOnScope Before(MenuHost->GeneratedClass);
    for(TFieldIterator<FProperty> P(MenuHost->GeneratedClass);P;++P)P->CopyCompleteValue(P->ContainerPtrToValuePtr<void>(Before.GetStructMemory()),P->ContainerPtrToValuePtr<void>(H));
