bool InstallDORNativeHistoricalProxySuppression(UBlueprint* Proxy)
{
    // The replicated proxy retains UI and replay metadata. Native owner work
    // belongs only to the PlayerState context, including late old callbacks.
    const TSet<FName> Effects={TEXT("EquipUpgrade"),TEXT("RefreshLoadoutFromSave"),TEXT("Server_SetLoadout"),TEXT("UpdateFromSaveGameInSlot"),TEXT("GetEquippedOverclock"),TEXT("DOR_Prepare"),TEXT("DOR_Begin"),TEXT("DOR_End"),TEXT("DOR_RestoreIfActive"),TEXT("DOR_ApplyOriginal"),TEXT("DOR_ApplyRewardCode"),TEXT("DOR_DebugSetIndex"),TEXT("DOR_ClearCurrentPair"),TEXT("DOR_ServerReportRemoteApply"),TEXT("DOR_ServerPublishRemoteCompletion")};
    const TSet<FName> Preserve={TEXT("DOR_ServerFinalizeReplayRequest"),TEXT("DOR_ServerFinishChoice")};
    TMap<FName,TSet<FName>> Calls;TSet<FName> Blocked;
    auto Historical=[](const FName Name){const FString S=Name.ToString();return S.StartsWith(TEXT("DOR91_"))||S.StartsWith(TEXT("DOR93_"))||S.StartsWith(TEXT("DOR359_"))||S.StartsWith(TEXT("DOR435_"))||S.StartsWith(TEXT("DOR425_"));};
    for(auto* G:Proxy->FunctionGraphs)
    {
        const FName Name=G->GetFName();if(Name.ToString().StartsWith(TEXT("DOR_Native"))||Preserve.Contains(Name))continue;
        if(Historical(Name)||Effects.Contains(Name))Blocked.Add(Name);
        for(auto* Node:G->Nodes)if(auto* C=Cast<UK2Node_CallFunction>(Node)){const FName Callee=C->FunctionReference.GetMemberName();Calls.FindOrAdd(Name).Add(Callee);if(Effects.Contains(Callee)||Historical(Callee))Blocked.Add(Name);if(auto* Pin=C->FindPin(TEXT("FunctionName")))if(!Pin->DefaultValue.IsEmpty())Calls.FindOrAdd(Name).Add(FName(*Pin->DefaultValue));}
    }
    bool Changed=true;while(Changed){Changed=false;for(const auto& Row:Calls)if(!Blocked.Contains(Row.Key)&&!Preserve.Contains(Row.Key))for(const auto Name:Row.Value)if(Blocked.Contains(Name)){Blocked.Add(Row.Key);Changed=true;break;}}
    auto Gate=[&](UEdGraph* G,UEdGraphPin* Start,UK2Node_FunctionEntry* Entry)
