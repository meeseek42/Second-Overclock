    auto* AP=FindFProperty<FArrayProperty>(H->GetClass(),TEXT("AttemptedPlayers"));auto* CP=FindFProperty<FArrayProperty>(H->GetClass(),TEXT("ConsumedPlayers"));auto& A=*AP->ContainerPtrToValuePtr<TArray<FString>>(H);auto& C=*CP->ContainerPtrToValuePtr<TArray<FString>>(H);A={TEXT("net-v1:revision-a|primary"),TEXT("net-v1:revision-a|secondary"),TEXT("net-v1:revision-b|primary")};C=A;
    Check(Invoke(TEXT("DOR_ManualRevisionMatches"),TEXT("net-v1:revision-a"),TEXT("primary"),0)==1,TEXT("carried-reservation-default-revision0"));
    Invoke(TEXT("DOR_RearmManual"),TEXT("net-v1:revision-a"),TEXT(""),0);Check(A.Num()==1&&C.Num()==1&&A[0]==TEXT("net-v1:revision-b|primary")&&C[0]==A[0],TEXT("exact-two-slot-rearm-preserves-other-player"));
    for(const TCHAR* Slot:{TEXT("primary"),TEXT("secondary")}){Check(Invoke(TEXT("DOR_ManualRevision"),TEXT("net-v1:revision-a"),Slot,0)==1,TEXT("both-saved-slots-have-revision1"));Check(Invoke(TEXT("DOR_ManualRevisionMatches"),TEXT("net-v1:revision-a"),Slot,0)==0,TEXT("old-settlement-rejected-after-save"));}
    A.Add(TEXT("net-v1:revision-a|primary"));C.Add(TEXT("net-v1:revision-a|primary"));Invoke(TEXT("DOR_RearmManual"),TEXT("net-v1:revision-a"),TEXT(""),0);
