    if(!Timeout||!Submit)return false;auto* Index=FindPin(Submit,TEXT("ChoiceIndex"));auto* Random=Index->LinkedTo[0];Index->BreakAllPinLinks();auto Prev=Submit->GetExecPin()->LinkedTo;Submit->GetExecPin()->BreakAllPinLinks();
    auto* Cache=AddVariableSet(EG,TEXT("TimeoutChoiceIndex"),0,0);Connect(Random,FindPin(Cache,TEXT("TimeoutChoiceIndex")));for(auto* P:Prev)Connect(P,Cache->GetExecPin());auto* Gen=AddVariableSet(EG,TEXT("TimeoutChoiceGeneration"),0,0);Connect(AddVariableGet(EG,TEXT("ActiveChoiceGeneration"),0,0)->GetValuePin(),FindPin(Gen,TEXT("TimeoutChoiceGeneration")));Connect(FindPin(Cache,UEdGraphSchema_K2::PN_Then),Gen->GetExecPin());auto* Active=AddVariableSet(EG,TEXT("TimeoutSubmissionActive"),0,0);FindPin(Active,TEXT("TimeoutSubmissionActive"))->DefaultValue=TEXT("true");Connect(FindPin(Gen,UEdGraphSchema_K2::PN_Then),Active->GetExecPin());Connect(FindPin(Active,UEdGraphSchema_K2::PN_Then),Submit->GetExecPin());Connect(AddVariableGet(EG,TEXT("TimeoutChoiceIndex"),0,0)->GetValuePin(),Index);
    auto Next=Submit->GetThenPin()->LinkedTo;Submit->GetThenPin()->BreakAllPinLinks();auto* Clear=AddVariableSet(EG,TEXT("TimeoutSubmissionActive"),0,0);FindPin(Clear,TEXT("TimeoutSubmissionActive"))->DefaultValue=TEXT("false");Connect(Submit->GetThenPin(),Clear->GetExecPin());for(auto* P:Next)Connect(FindPin(Clear,UEdGraphSchema_K2::PN_Then),P);
