        auto* PostEvent=AddSelfCall(EG,TEXT("DOR_PostPlayerNotification"),0,0);Connect(Event->FindPin(UEdGraphSchema_K2::PN_Then),PostEvent->GetExecPin());Connect(Event->FindPin(TEXT("Message")),FindPin(PostEvent,TEXT("Message")));
    }
