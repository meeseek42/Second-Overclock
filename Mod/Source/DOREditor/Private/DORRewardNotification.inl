        for(const TCHAR* Field:{TEXT("RuntimePairANames"),TEXT("RuntimePairBNames")}){auto* A=F.Get(Field);auto* Valid=F.Array(TEXT("Array_IsValidIndex"),A);Connect(PairIndex->GetReturnValuePin(),FindPin(Valid,TEXT("IndexToTest")));F.QuietRequire(Valid->GetReturnValuePin());auto* Get=F.Array(TEXT("Array_Get"),A);Connect(PairIndex->GetReturnValuePin(),FindPin(Get,TEXT("Index")));F.Set(F.Variable(Message),F.Join(Message,FindPin(Get,TEXT("Item"))));if(FString(Field)==TEXT("RuntimePairANames"))F.Set(F.Variable(Message),F.Join(Message,F.Str(TEXT(" + "))));}F.Set(F.Variable(Message),F.Join(Message,F.Str(TEXT("]"))));
