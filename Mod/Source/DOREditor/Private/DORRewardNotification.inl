("DOR_ClientPlayerNotification"));Connect(Recipient,FindPin(Notify,UEdGraphSchema_K2::PN_Self));Connect(Message,FindPin(Notify,TEXT("Message")));for(auto* B:{Unique,Ownership,CompatibleGate,Ready,InSession,PlayerValid,Related,Valid})F.Merge(B->GetElsePin());F.Tail=FindPin(Loop,TEXT("Completed"));F.Done();F.Compile();
