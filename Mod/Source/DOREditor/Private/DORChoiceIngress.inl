    {
        FDORNativeReceiptGraph F(Master,TEXT("DOR_ChoiceIngressOutcome"),Master->GeneratedClass);auto* Actor=F.Input(TEXT("ProxyActor"),MakeObjectPinType(AActor::StaticClass()));auto* Index=F.Input(TEXT("ChoiceIndex"),MakeIntPinType());auto* Stage=F.Input(TEXT("Stage"),MakeStringPinType());auto* P=F.Cache(TEXT("Proxy"),F.Cast(Actor,Proxy->GeneratedClass));F.QuietRequire(F.IsValid(P));auto* Gen=F.Field(P,Proxy->GeneratedClass,TEXT("ActiveChoiceGeneration"));F.QuietRequire(F.Not(F.Eq(Gen,F.Field(P,Proxy->GeneratedClass,TEXT("ChoiceIngressOutcomeGeneration")))));F.Put(P,Proxy->GeneratedClass,TEXT("ChoiceIngressOutcomeGeneration"),Gen);
        FDORNativeProbeLine D(F,TEXT("ChoiceOutcome"),TEXT("[DOR-CHOICE-INGRESS]|boundary=submit-outcome|wire=index-only"));D.Add(TEXT("stage"),Stage,NAME_None);D.Add(TEXT("proxy"),D.Path(P),NAME_None);D.Add(TEXT("widget"),D.Path(F.Field(P,Proxy->GeneratedClass,TEXT("CurrentChoiceWidget"))),NAME_None);D.Add(TEXT("index"),Index,TEXT("Conv_IntToString"));D.Add(TEXT("serverGeneration"),Gen,TEXT("Conv_IntToString"));D.Add(TEXT("round"),F.Field(P,Proxy->GeneratedClass,TEXT("ActiveObjectiveKey")),NAME_None);D.Add(TEXT("active"),F.Field(P,Proxy->GeneratedClass,TEXT("SelectionActive")));D.Add(TEXT("pending"),F.Field(P,Proxy->GeneratedClass,TEXT("RewardApplyPending")));D.Add(TEXT("offerCount"),F.Array(TEXT("Array_Length"),F.Field(P,Proxy->GeneratedClass,TEXT("OfferedChoiceCodes")))->GetReturnValuePin(),TEXT("Conv_IntToString"));D.Add(TEXT("recoveryConflict"),F.Get(TEXT("NativeRecoveryConflict")));D.Add(TEXT("lifecycleClosed"),F.Get(TEXT("NativeLifecycleClosed")));D.Add(TEXT("executionHeld"),F.Get(TEXT("NativeExecutionHeld")));D.Add(TEXT("now"),F.RealNow(),TEXT("Conv_FloatToString"));D.Add(TEXT("deadline"),F.Get(TEXT("NativeRoundDeadline")),TEXT("Conv_FloatToString"));D.Record();F.Self(TEXT("DOR_DiagnosticFlush"));F.Done();F.Compile();
    }
    {
        FDORNativeReceiptGraph F(Proxy,TEXT("DOR_ChoiceIngressRpc"),Master->GeneratedClass);auto* Index=F.Input(TEXT("ChoiceIndex"),MakeIntPinType());auto* Gen=F.Get(TEXT("ActiveChoiceGeneration"));F.QuietRequire(F.Not(F.Eq(Gen,F.Get(TEXT("ChoiceIngressRpcGeneration")))));F.Set(TEXT("ChoiceIngressRpcGeneration"),Gen);auto* Find=F.Call(UGameplayStatics::StaticClass(),TEXT("GetActorOfClass"));FindPin(Find,TEXT("ActorClass"))->DefaultObject=Master->GeneratedClass;auto* M=F.Cache(TEXT("Master"),F.Cast(Find->GetReturnValuePin(),Master->GeneratedClass));F.QuietRequire(F.IsValid(M));FDORNativeProbeLine D(F,TEXT("ChoiceRpc"),TEXT("[DOR-CHOICE-INGRESS]|boundary=submit-rpc-entry|wire=index-only"));D.Add(TEXT("proxy"),D.Path(SelfPin(F.G,0,700)),NAME_None);D.Add(TEXT("masterRef"),D.Path(F.Get(TEXT("MasterRef"))),NAME_None);D.Add(TEXT("index"),Index,TEXT("Conv_IntToString"));D.Add(TEXT("serverGeneration"),Gen,TEXT("Conv_IntToString"));D.Add(TEXT("round"),F.Get(TEXT("ActiveObjectiveKey")),NAME_None);D.Add(TEXT("active"),F.Get(TEXT("SelectionActive")));D.Add(TEXT("pending"),F.Get(TEXT("RewardApplyPending")));auto* Record=F.Call(Master->GeneratedClass,TEXT("DOR_DiagnosticRecordOnly"));Connect(M,FindPin(Record,UEdGraphSchema_K2::PN_Self));Connect(D.Line,FindPin(Record,TEXT("Message")));auto* Flush=F.Call(Master->GeneratedClass,TEXT("DOR_DiagnosticFlush"));Connect(M,FindPin(Flush,UEdGraphSchema_K2::PN_Self));F.Done();F.Compile();
    }
