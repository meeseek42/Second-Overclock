        FDORNativeReceiptGraph F(Widget,TEXT("DOR_ChoiceIngressWidget"),Master->GeneratedClass);auto* Index=F.Input(TEXT("Index"),MakeIntPinType());auto* Stage=F.Input(TEXT("Stage"),MakeStringPinType());auto* Ready=F.Branch(F.Eq(Index,F.Int(-1)));F.QuietRequire(F.Not(F.Get(TEXT("ChoiceIngressReady"))));F.Set(TEXT("ChoiceIngressReady"),nullptr,TEXT("true"));auto* Join=F.Tail;F.Tail=Ready->GetElsePin();auto* Contains=F.Array(TEXT("Array_Contains"),F.Get(TEXT("ChoiceIngressClicks")));Connect(Index,FindPin(Contains,TEXT("ItemToFind")));F.QuietRequire(F.Not(Contains->GetReturnValuePin()));auto* Add=F.Array(TEXT("Array_AddUnique"),F.Get(TEXT("ChoiceIngressClicks")));Connect(Index,FindPin(Add,TEXT("NewItem")));F.Merge(Join);
        auto* Find=F.Call(UGameplayStatics::StaticClass(),TEXT("GetActorOfClass"));FindPin(Find,TEXT("ActorClass"))->DefaultObject=Master->GeneratedClass;auto* M=F.Cache(TEXT("Master"),F.Cast(Find->GetReturnValuePin(),Master->GeneratedClass));F.QuietRequire(F.IsValid(M));auto* P=F.Get(TEXT("OwningDORProxy"));FDORNativeProbeLine D(F,TEXT("ChoiceWidget"),TEXT("[DOR-CHOICE-INGRESS]|boundary=widget|submit-wire=index-only"));D.Add(TEXT("stage"),Stage,NAME_None);D.Add(TEXT("widget"),D.Path(SelfPin(F.G,0,700)),NAME_None);D.Add(TEXT("proxy"),D.Path(P),NAME_None);D.Add(TEXT("index"),Index,TEXT("Conv_IntToString"));D.Add(TEXT("enabled"),Read(F,UWidget::StaticClass(),TEXT("GetIsEnabled"),SelfPin(F.G,0,700)));D.Add(TEXT("keyboardFocus"),Read(F,UWidget::StaticClass(),TEXT("HasKeyboardFocus"),SelfPin(F.G,0,700)));D.Add(TEXT("descendantFocus"),Read(F,UWidget::StaticClass(),TEXT("HasFocusedDescendants"),SelfPin(F.G,0,700)));D.Add(TEXT("inViewport"),Read(F,UUserWidget::StaticClass(),TEXT("IsInViewport"),SelfPin(F.G,0,700)));auto* Have=F.Branch(F.IsValid(P));D.Add(TEXT("localControlGeneration"),F.Field(P,Proxy->GeneratedClass,TEXT("SelectionControlLocalGeneration")),TEXT("Conv_IntToString"));D.Add(TEXT("localControlHeld"),F.Field(P,Proxy->GeneratedClass,TEXT("SelectionControlLocalHeld")));F.Merge(Have->GetElsePin());auto* Record=F.Call(Master->GeneratedClass,TEXT("DOR_DiagnosticRecordOnly"));Connect(M,FindPin(Record,UEdGraphSchema_K2::PN_Self));Connect(D.Line,FindPin(Record,TEXT("Message")));auto* Flush=F.Call(Master->GeneratedClass,TEXT("DOR_DiagnosticFlush"));Connect(M,FindPin(Flush,UEdGraphSchema_K2::PN_Self));F.Done();F.Compile();
    }
    auto Insert=[&](UEdGraphPin* Out,UClass* Class,const TCHAR* Name,UEdGraphPin* Target){auto* G=Out->GetOwningNode()->GetGraph();auto Next=Out->LinkedTo;Out->BreakAllPinLinks();auto* C=Class?AddCall(G,Class,Name,0,0):AddSelfCall(G,Name,0,0);if(Target)Connect(Target,FindPin(C,UEdGraphSchema_K2::PN_Self));Connect(Out,C->GetExecPin());for(auto* N:Next)Connect(C->GetThenPin(),N);return C;};
    auto* EG=FBlueprintEditorUtils::FindEventGraph(Proxy);for(auto* N:TArray<UEdGraphNode*>(EG->Nodes))if(auto* E=Cast<UK2Node_CustomEvent>(N))if(E->CustomFunctionName==TEXT("DOR_ServerSubmitChoice")){auto* C=Insert(E->FindPin(UEdGraphSchema_K2::PN_Then),nullptr,TEXT("DOR_ChoiceIngressRpc"),nullptr);Connect(E->FindPin(TEXT("ChoiceIndex")),FindPin(C,TEXT("ChoiceIndex")));}
    auto* WG=FBlueprintEditorUtils::FindEventGraph(Widget);for(auto* N:TArray<UEdGraphNode*>(WG->Nodes))if(auto* E=Cast<UK2Node_CustomEvent>(N))for(int32 I=0;I<3;++I)if(E->CustomFunctionName==*FString::Printf(TEXT("DOR_Choice%dClicked"),I+1)){auto* C=Insert(E->FindPin(UEdGraphSchema_K2::PN_Then),nullptr,TEXT("DOR_ChoiceIngressWidget"),nullptr);FindPin(C,TEXT("Index"))->DefaultValue=FString::FromInt(I);FindPin(C,TEXT("Stage"))->DefaultValue=TEXT("first-click");}
