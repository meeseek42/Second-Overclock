    for(auto* N:TArray<UEdGraphNode*>(EG->Nodes))if(auto* C=Cast<UK2Node_CallFunction>(N))if(C->FunctionReference.GetMemberName()==TEXT("SetUserFocus")){auto* Cast=AddNode<UK2Node_DynamicCast>(EG,0,0);Cast->TargetType=Widget->GeneratedClass;Cast->SetPurity(true);Cast->AllocateDefaultPins();ForcePinType(Cast->GetCastSourcePin(),MakeObjectPinType(UObject::StaticClass()));Connect(AddVariableGet(EG,TEXT("CurrentChoiceWidget"),0,0)->GetValuePin(),Cast->GetCastSourcePin());auto* Ready=Insert(C->GetThenPin(),Widget->GeneratedClass,TEXT("DOR_ChoiceIngressWidget"),Cast->GetCastResultPin());FindPin(Ready,TEXT("Index"))->DefaultValue=TEXT("-1");FindPin(Ready,TEXT("Stage"))->DefaultValue=TEXT("widget-ready");}
    auto* Submit=FindFunctionGraph(Master,TEXT("DOR_NativeSubmitChoice"));auto* Entry=FindFunctionEntry(Submit);int32 Gate=0;for(auto* N:TArray<UEdGraphNode*>(Submit->Nodes))if(auto* Result=Cast<UK2Node_FunctionResult>(N)){auto* Value=Result->FindPin(UEdGraphSchema_K2::PN_ReturnValue);const bool Enqueued=Value&&Value->DefaultValue==TEXT("true");const FString Stage=Enqueued?TEXT("enqueued"):FString::Printf(TEXT("rejected-gate-%d"),++Gate);auto* In=Result->FindPin(UEdGraphSchema_K2::PN_Execute);for(auto* Out:TArray<UEdGraphPin*>(In->LinkedTo)){auto* C=Insert(Out,nullptr,TEXT("DOR_ChoiceIngressOutcome"),nullptr);for(const TCHAR* Name:{TEXT("ProxyActor"),TEXT("ChoiceIndex")})Connect(Entry->FindPin(Name),FindPin(C,Name));FindPin(C,TEXT("Stage"))->DefaultValue=Stage;}}
    for(auto* BP:{Master,Proxy,static_cast<UBlueprint*>(Widget)}){FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(BP);FKismetEditorUtilities::CompileBlueprint(BP);if(BP->Status==BS_Error)return false;}return true;
