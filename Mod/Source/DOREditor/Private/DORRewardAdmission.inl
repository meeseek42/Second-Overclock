// Admission stays inside the existing objective poll. No elapsed-time retry or
// new objective identity is introduced.
bool BuildDORSecondaryAdmission(UBlueprint* Master)
{
    for(int32 I=0;I<2;++I){AddTypedVariable(Master,*FString::Printf(TEXT("SecondaryDecision%d"),I),MakeStringPinType());AddTypedVariable(Master,*FString::Printf(TEXT("SecondaryReceipts%d"),I),MakeIntPinType());}
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Master);FKismetEditorUtilities::CompileBlueprint(Master);
    for(int32 I=0;I<2;++I)
    {
        FDORNativeReceiptGraph F(Master,*FString::Printf(TEXT("DOR_SecondaryDecision%d"),I),Master->GeneratedClass);auto* Objective=F.Input(TEXT("Objective"),MakeObjectPinType(UObjective::StaticClass()));F.QuietRequire(F.IsValid(Objective));
        auto* Path=F.Call(UKismetSystemLibrary::StaticClass(),TEXT("GetPathName"));Connect(Objective,FindPin(Path,TEXT("Object")));auto* Key=F.Cache(TEXT("ObjectiveKey"),Path->GetReturnValuePin());
        auto* Complete=F.Call(UObjective::StaticClass(),TEXT("IsCompleted"));Connect(Objective,FindPin(Complete,UEdGraphSchema_K2::PN_Self));auto* Completed=F.Cache(TEXT("Completed"),Complete->GetReturnValuePin());auto* Contains=F.Array(TEXT("Array_Contains"),F.Get(TEXT("CompletedSecondaryKeys")));Connect(Key,FindPin(Contains,TEXT("ItemToFind")));auto* Seen=F.Cache(TEXT("Seen"),Contains->GetReturnValuePin());
        // This is the exact roster provider used by AugmentMasterConcurrentSessions,
        // including fallback recipients. Session/handshake arrays are not the roster.
        auto* Players=F.Call(UActorFunctionLibrary::StaticClass(),TEXT("GetAllPlayerCharacters"));Connect(SelfPin(F.G,0,700),FindPin(Players,TEXT("WorldContext")));auto* Count=F.Cache(TEXT("Recipients"),F.Array(TEXT("Array_Length"),Players->GetReturnValuePin())->GetReturnValuePin());
        auto* GS=F.Call(UGameplayStatics::StaticClass(),TEXT("GetGameState"));auto* State=F.Cache(TEXT("GameState"),F.Cast(GS->GetReturnValuePin(),AFSDGameState::StaticClass()));auto* Ready=F.Cache(TEXT("MissionReady"),F.Eq(F.Int(0),F.Int(1)));auto* Match=F.Cache(TEXT("MatchStarted"),F.Eq(F.Int(0),F.Int(1)));auto* Rig=F.Cache(TEXT("OnSpaceRig"),F.Eq(F.Int(0),F.Int(0)));auto* Valid=F.Branch(F.IsValid(State));auto* Started=F.Call(AGameStateBase::StaticClass(),TEXT("HasMatchStarted"));Connect(State,FindPin(Started,UEdGraphSchema_K2::PN_Self));F.Set(F.Variable(Match),Started->GetReturnValuePin());F.Set(F.Variable(Rig),F.Field(State,AFSDGameState::StaticClass(),TEXT("IsOnSpaceRig")));auto* Positive=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Greater_IntInt"));Connect(Count,FindPin(Positive,TEXT("A")));F.Set(F.Variable(Ready),F.And(Match,F.And(F.Not(Rig),Positive->GetReturnValuePin())));F.Merge(Valid->GetElsePin());
        auto* Handle=F.Cache(TEXT("Handle"),F.And(Completed,F.And(F.Not(Seen),Ready)));auto* Signature=F.Cache(TEXT("Decision"),Key);for(auto* Value:{Completed,Seen,Ready,Match,Rig,F.Get(TEXT("DebugOverride"))})F.Set(F.Variable(Signature),F.Join(F.Join(Signature,F.Str(TEXT("|"))),F.Text(Value,TEXT("Conv_BoolToString"))));F.Set(F.Variable(Signature),F.Join(Signature,F.Text(Count,TEXT("Conv_IntToString"))));
        const FName Last(*FString::Printf(TEXT("SecondaryDecision%d"),I)),Rows(*FString::Printf(TEXT("SecondaryReceipts%d"),I));auto* Under=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Less_IntInt"));Connect(F.Get(Rows),FindPin(Under,TEXT("A")));FindPin(Under,TEXT("B"))->DefaultValue=TEXT("8");auto* Changed=F.Branch(F.Eq(Handle,F.And(F.Not(F.Eq(Signature,F.Get(Last),TEXT("EqualEqual_StrStr"))),Under->GetReturnValuePin()),TEXT("BooleanOR")));F.Set(Last,Signature);auto* Inc=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Add_IntInt"));Connect(F.Get(Rows),FindPin(Inc,TEXT("A")));FindPin(Inc,TEXT("B"))->DefaultValue=TEXT("1");F.Set(Rows,Inc->GetReturnValuePin());
        FDORNativeProbeLine D(F,TEXT("SecondaryDecision"),TEXT("[DOR-SECONDARY]|stage=completion-decision|roster=GetAllPlayerCharacters"));D.Add(TEXT("index"),F.Int(I),TEXT("Conv_IntToString"));D.Add(TEXT("objective"),Key,NAME_None);D.Add(TEXT("missionReady"),Ready);D.Add(TEXT("matchStarted"),Match);D.Add(TEXT("onSpaceRig"),Rig);D.Add(TEXT("isCompleted"),Completed);D.Add(TEXT("alreadySeen"),Seen);D.Add(TEXT("DebugOverride"),F.Get(TEXT("DebugOverride")));D.Add(TEXT("recipients"),Count,TEXT("Conv_IntToString"));D.Add(TEXT("handle"),Handle);D.Add(TEXT("defer"),F.And(Completed,F.And(F.Not(Seen),F.Not(Ready))));D.Record();F.Self(TEXT("DOR_DiagnosticFlush"));F.Merge(Changed->GetElsePin());F.Return(Handle);F.Compile();
    }
    {
        FDOR91Graph F(Master,TEXT("DOR_PollObjectives"),Master->GeneratedClass);F.QuietRequire(F.Get(TEXT("RewardSystemEnabled")));auto* GS=F.Call(UGameplayStatics::StaticClass(),TEXT("GetGameState"));auto* State=F.Cache(TEXT("State"),F.Cast(GS->GetReturnValuePin(),AFSDGameState::StaticClass()));auto* Have=F.Branch(F.IsValid(State));auto* Get=F.Call(AFSDGameState::StaticClass(),TEXT("GetSecondaryObjectives"));Connect(State,FindPin(Get,UEdGraphSchema_K2::PN_Self));auto* Objectives=F.Cache(TEXT("Objectives"),Get->GetReturnValuePin());
        for(int32 I=0;I<2;++I){auto* Range=F.Call(UKismetMathLibrary::StaticClass(),TEXT("Greater_IntInt"));Connect(F.Array(TEXT("Array_Length"),Objectives)->GetReturnValuePin(),FindPin(Range,TEXT("A")));FindPin(Range,TEXT("B"))->DefaultValue=FString::FromInt(I);auto* InRange=F.Branch(Range->GetReturnValuePin());auto* Item=F.Array(TEXT("Array_Get"),Objectives);FindPin(Item,TEXT("Index"))->DefaultValue=FString::FromInt(I);auto* Objective=F.Cache(*FString::Printf(TEXT("Objective%d"),I),FindPin(Item,TEXT("Item")));auto* Admit=F.Self(*FString::Printf(TEXT("DOR_SecondaryDecision%d"),I));Connect(Objective,FindPin(Admit,TEXT("Objective")));auto* Allowed=F.Branch(Admit->GetReturnValuePin());auto* Path=F.Call(UKismetSystemLibrary::StaticClass(),TEXT("GetPathName"));Connect(Objective,FindPin(Path,TEXT("Object")));auto* Key=F.Cache(*FString::Printf(TEXT("Key%d"),I),Path->GetReturnValuePin());auto* Add=F.Array(TEXT("Array_AddUnique"),F.Get(TEXT("CompletedSecondaryKeys")));Connect(Key,FindPin(Add,TEXT("NewItem")));auto* Handle=F.Self(TEXT("DOR_HandleSecondaryCompleted"));Connect(Key,FindPin(Handle,TEXT("ObjectiveKey")));F.Merge(Allowed->GetElsePin());F.Merge(InRange->GetElsePin());}
        F.Merge(Have->GetElsePin());F.Self(TEXT("DOR_ProcessRewardQueue"));F.Done();F.Compile();
    }
    return Master->Status!=BS_Error;
}
