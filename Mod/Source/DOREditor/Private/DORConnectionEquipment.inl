        auto* C=F.Self(TEXT("DOR_ConnectionHostEndpointIndex"));Connect(E,FindPin(C,TEXT("Endpoint")));Connect(X,FindPin(C,TEXT("Exchange")));auto* I=F.Cache(TEXT("Index"),C->GetReturnValuePin());F.QuietRequire(F.Not(F.Eq(I,F.Int(-1))));F.QuietRequire(F.At(F.Get(TEXT("ConnectionReady")),I));auto* PageObject=F.Cache(TEXT("Page"),F.Get(TEXT("ConnectionEQPage")));F.QuietRequire(F.IsValid(PageObject));auto* Report=F.Call(PC,TEXT("DOR_EQReport"));Connect(PageObject,FindPin(Report,UEdGraphSchema_K2::PN_Self));Connect(F.At(F.Get(TEXT("ConnectionStates")),I),FindPin(Report,TEXT("SenderState")));Connect(E,FindPin(Report,TEXT("Endpoint")));Connect(X,FindPin(Report,TEXT("Exchange")));Connect(Request,FindPin(Report,TEXT("Request")));for(auto V:Values)Connect(V.Value,FindPin(Report,V.Key));F.Done();F.Compile();
    }
