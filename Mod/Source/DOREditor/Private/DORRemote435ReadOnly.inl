// Experimental 435-only owner value producer. No owner mission mutation.
struct FDOR91Graph : FDOR435Graph
{
    FDOR91Graph(UBlueprint* BP,FName Name,UClass* MC):FDOR435Graph(BP,Name,MC){}
    void Until(const TCHAR* Variable)
    {auto* N=Call(UKismetMathLibrary::StaticClass(),TEXT("Add_FloatFloat"));Connect(Now(),FindPin(N,TEXT("A")));FindPin(N,TEXT("B"))->DefaultValue=TEXT("5.0");Set(Variable,N->GetReturnValuePin());}
    UEdGraphPin* Expired(const TCHAR* Variable)
    {auto* N=Call(UKismetMathLibrary::StaticClass(),TEXT("GreaterEqual_FloatFloat"));Connect(Now(),FindPin(N,TEXT("A")));Connect(Get(Variable),FindPin(N,TEXT("B")));return N->GetReturnValuePin();}
    void Note(const TCHAR* Stage,bool Owner=false,UEdGraphPin* Detail=nullptr)
    {
        auto* L=DORSafeConcat(*this,FString::Printf(TEXT("[DOR-SMG]|build=%s|producer=readonly-clone|stage=%s|key="),DORResearchBuildTag,Stage),Get(Owner?TEXT("O91Key"):TEXT("S91Key")));
        L=Add(L,TEXT("|generation="),Text(Get(Owner?TEXT("O91Generation"):TEXT("S91Generation")),TEXT("Conv_IntToString")));
        L=Add(L,TEXT("|phase="),Text(Get(Owner?TEXT("O91Phase"):TEXT("S91Phase")),TEXT("Conv_IntToString")));
        if(Detail)L=Add(L,TEXT("|data="),Detail);
        Record(Get(Owner?TEXT("O91Master"):TEXT("MasterRef")),L);
    }
    void Need(UEdGraphPin* Value,const TCHAR* Reason,const TCHAR* Failure=nullptr,bool Owner=false)
    {auto* B=Branch(Value);Tail=B->GetElsePin();Note(Reason,Owner);if(Failure){auto* N=Self(Failure);if(N->FindPin(TEXT("Reason")))FindPin(N,TEXT("Reason"))->DefaultValue=Reason;}Done();Tail=B->GetThenPin();}
    void Merge(UEdGraphPin* Other)
    {auto* N=AddNode<UK2Node_IfThenElse>(G,++Serial*160,0);N->AllocateDefaultPins();FindPin(N,UEdGraphSchema_K2::PN_Condition)->DefaultValue=TEXT("true");Connect(Tail,N->GetExecPin());Connect(Other,N->GetExecPin());Tail=N->GetThenPin();}
};

